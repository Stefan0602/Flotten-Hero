# =============================================
# TransportPro - Umgebungsvariablen (Beispiel)
# =============================================

# Datenbank-Verbindung
# Für lokale Entwicklung (SQLite):
DATABASE_URL="file:./prisma/dev.db"

# Für Produktion mit PostgreSQL:
# DATABASE_URL="postgresql://user:password@localhost:5432/transportpro?schema=public"

# Geheimer Schlüssel für JWT-Session-Verschlüsselung
# WICHTIG: In der Produktion bitte einen langen, zufälligen String verwenden!
AUTH_SECRET="transportpro-super-secret-key-change-this-in-production-please-2026"

# Umgebung (development | production)
NODE_ENV="development"
